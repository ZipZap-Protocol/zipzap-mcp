{
  "name": "@zipzap-protocol/mcp",
  "version": "1.3.0",
  "type": "module",
  "description": "Zero-hosting Model Context Protocol (MCP) server for ZipZap Multi-Chain DEX & 4-Bridge Aggregator (8 chains, 30+ DEXs, Across/Relay/deBridge/LI.FI)",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "zipzap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "instructions.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zipzap",
    "dex",
    "aggregator",
    "defi",
    "defai",
    "ai-agent",
    "solana",
    "base",
    "kaia",
    "arbitrum"
  ],
  "author": "ZipZap Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZipZap-Protocol/zipzap-mcp.git"
  },
  "homepage": "https://zipzap-protocol.github.io/zipzap-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@zipzap-protocol/sdk": "^1.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
